# Copia este archivo a .env y completa los valores.
ANTHROPIC_API_KEY=sk-ant-...
# SQLite por defecto; para PostgreSQL:
# DATABASE_URL=postgresql+psycopg://usuario:password@localhost:5432/manuales_mop
DATABASE_URL=sqlite:///./manuales_mop.db
AI_MODEL=claude-opus-5-5
AI_EFFORT=high
MARKDOWN_DIR=./data/markdown
